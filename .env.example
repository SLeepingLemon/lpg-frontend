# Copy to .env.local and fill in real values. Never commit real secrets.
# NOTE: every VITE_* variable is embedded in the public JS bundle.

# --- Auth mode ---------------------------------------------------------------
# true  = mock auth (no Firebase needed; any email/password signs in)
# false = Firebase Auth (requires the VITE_FIREBASE_* values below)
VITE_USE_MOCK_AUTH=true

# --- Firebase (Project settings → General → Your apps → Web app) -------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Backend API (future Node.js + Express) ----------------------------------
VITE_API_BASE_URL=http://localhost:4000

# --- HiveMQ MQTT over WebSocket (placeholder, not used yet) ------------------
# Prefer relaying readings through the backend instead of putting broker
# credentials in the browser.
VITE_HIVEMQ_URL=wss://your-cluster.s1.eu.hivemq.cloud:8884/mqtt
VITE_HIVEMQ_USERNAME=your-readonly-username
VITE_HIVEMQ_PASSWORD=your-readonly-password
VITE_HIVEMQ_TOPIC=smartlpg/esp32-lpg-01/readings
